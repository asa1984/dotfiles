# .chezmoidata/packages.toml の宣言を冪等に収束させる (追加のみ、削除はしない)。
# 宣言の変更はテンプレート展開結果に反映されるため、chezmoi が自動で再実行する。
$ErrorActionPreference = 'Stop'

function Update-SessionPath {
    $env:Path = [Environment]::GetEnvironmentVariable('Path', 'User') + ';' + [Environment]::GetEnvironmentVariable('Path', 'Machine')
}

# pwsh 7 から呼ばれると PSModulePath が汚染され、5.1 のモジュール自動読み込み
# (Get-FileHash 等、scoop が依存) が壊れるため、5.1 の既定値にリセットする
$env:PSModulePath = "$env:USERPROFILE\Documents\WindowsPowerShell\Modules;$env:ProgramFiles\WindowsPowerShell\Modules;$env:SystemRoot\system32\WindowsPowerShell\v1.0\Modules"

function Install-WingetPackage([string]$Id) {
    winget list --id $Id --exact --accept-source-agreements | Out-Null
    if ($LASTEXITCODE -eq 0) { return }
    Write-Host "winget: installing $Id"
    winget install --id $Id --exact --scope user --accept-package-agreements --accept-source-agreements --disable-interactivity
    if ($LASTEXITCODE -ne 0) { throw "winget install failed: $Id" }
}

function Install-WingetMachinePackage([string]$Id, [string]$Override) {
    winget list --id $Id --exact --accept-source-agreements | Out-Null
    if ($LASTEXITCODE -eq 0) { return }
    Write-Host "winget: installing $Id (machine scope, UAC prompt will appear)"
    winget install --id $Id --exact --accept-package-agreements --accept-source-agreements --override $Override
    if ($LASTEXITCODE -ne 0) { throw "winget install failed: $Id" }
}

function Install-ScoopBucket([string]$Name) {
    $dir = Join-Path $env:USERPROFILE "scoop\buckets\$Name"
    if (Test-Path $dir) { return }
    Write-Host "scoop: adding bucket $Name"
    scoop bucket add $Name
    # scoop は失敗しても exit code を返さないことがあるため実体を確認する
    if (-not (Test-Path $dir)) { throw "scoop bucket add failed: $Name" }
}

function Install-ScoopApp([string]$Name) {
    $dir = Join-Path $env:USERPROFILE "scoop\apps\$Name"
    if (Test-Path $dir) { return }
    Write-Host "scoop: installing $Name"
    scoop install $Name
    # scoop は失敗しても exit code を返さないことがあるため実体を確認する
    if (-not (Test-Path (Join-Path $dir 'current'))) { throw "scoop install failed: $Name" }
}

Update-SessionPath

# --- winget ---
{{ range .packages.winget -}}
Install-WingetPackage '{{ . }}'
{{ end }}
Update-SessionPath

# --- winget (マシンスコープ、要昇格) ---
{{ range .packages.winget_machine -}}
Install-WingetMachinePackage '{{ .id }}' '{{ .override }}'
{{ end }}
# --- scoop 本体のブートストラップ (新マシン用) ---
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host 'scoop: bootstrapping'
    Invoke-RestMethod https://get.scoop.sh | Invoke-Expression
    Update-SessionPath
}

# --- scoop ---
{{ range .packages.scoop.buckets -}}
Install-ScoopBucket '{{ . }}'
{{ end }}
{{ range .packages.scoop.apps -}}
Install-ScoopApp '{{ . }}'
{{ end }}
Write-Host 'Package convergence complete.'
